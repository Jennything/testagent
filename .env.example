# ── Claude (curation scoring + copywriting) ─────────────────────────────
ANTHROPIC_API_KEY=

# ── Telegram (human approval inbox) ─────────────────────────────────────
# Create a bot with @BotFather, then message it once and hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Instagram (Meta Graph API, via a Facebook Page linked to an IG Business acct) ─
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# ── Threads (separate OAuth app in the Meta developer console) ─────────
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ── Public image hosting for card PNGs (Graph API needs a public URL) ──
# Option A: Cloudinary (recommended, free tier is plenty for this volume)
CLOUDINARY_URL=
# Option B: self-hosted static server (src/server/index.ts) behind a public domain
BASE_PUBLIC_URL=http://localhost:8787
IMAGE_HOST=local

# ── X / Reddit / HN source monitoring ───────────────────────────────────
# X API is optional & paid — leave blank to skip that source.
X_BEARER_TOKEN=

# ── Misc ────────────────────────────────────────────────────────────────
PORT=8787
TIMEZONE=Asia/Seoul
DAILY_POST_TARGET=3
