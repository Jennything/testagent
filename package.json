{
  "name": "ai-pulse-media",
  "version": "0.1.0",
  "private": true,
  "description": "1-person AI news + meme media automation pipeline (Instagram + Threads)",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:collect": "ts-node src/pipeline/collectAndDraft.ts",
    "dev:scheduler": "ts-node src/pipeline/runScheduler.ts",
    "dev:bot": "ts-node src/approval/emailBot.ts",
    "dev:publisher": "ts-node src/publish/publisher.ts",
    "dev:analytics": "ts-node src/analytics/insights.ts",
    "dev:server": "ts-node src/server/index.ts",
    "test:render": "ts-node scripts/test-render.ts",
    "retry-failed": "ts-node scripts/retry-failed.ts",
    "start:scheduler": "node dist/pipeline/runScheduler.js",
    "start:bot": "node dist/approval/emailBot.js",
    "start:publisher": "node dist/publish/publisher.js",
    "start:analytics": "node dist/analytics/insights.js",
    "start:server": "node dist/server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "axios": "^1.7.9",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imapflow": "^1.0.171",
    "lowdb": "^1.0.0",
    "mailparser": "^3.7.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "playwright": "^1.49.1",
    "rss-parser": "^3.13.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
